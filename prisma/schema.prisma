generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model group_members {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id     String     @db.Uuid
  user_id      String     @db.Uuid
  role         group_role @default(MEMBER)
  joined_at    DateTime   @default(now()) @db.Timestamptz(6)
  last_read_at DateTime?  @db.Timestamptz(6)
  groups       groups     @relation(fields: [group_id], references: [id], onDelete: Cascade)
  users        users      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([group_id, user_id], map: "uq_group_members_group_user")
  @@index([group_id, role], map: "idx_group_members_group_role")
  @@index([user_id], map: "idx_group_members_user_id")
}

model groups {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String          @db.VarChar(120)
  image_url     String
  bio           String          @default("") @db.VarChar(160)
  owner_id      String          @db.Uuid
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  group_members group_members[]
  users         users           @relation(fields: [owner_id], references: [id])
  notifications notifications[]
  outings       outings[]

  @@index([owner_id], map: "idx_groups_owner_id")
}

model notifications {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String            @db.Uuid
  type       notification_type @default(SYSTEM)
  title      String?           @db.VarChar(200)
  body       String
  image_url  String?
  outing_id  String?           @db.Uuid
  group_id   String?           @db.Uuid
  action     Boolean           @default(false)
  is_read    Boolean           @default(false)
  read_at    DateTime?         @db.Timestamptz(6)
  data       Json?
  created_at DateTime          @default(now()) @db.Timestamptz(6)
  groups     groups?           @relation(fields: [group_id], references: [id])
  outings    outings?          @relation(fields: [outing_id], references: [id])
  users      users             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at(sort: Desc)], map: "idx_notifications_user_created")
}

model outing_attendance {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outing_id  String            @db.Uuid
  user_id    String            @db.Uuid
  status     attendance_status
  created_at DateTime          @default(now()) @db.Timestamptz(6)
  updated_at DateTime          @default(now()) @db.Timestamptz(6)
  outings    outings           @relation(fields: [outing_id], references: [id], onDelete: Cascade)
  users      users             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([outing_id, user_id], map: "uq_outing_attendance_outing_user")
  @@index([outing_id, status], map: "idx_outing_attendance_outing_status")
}

model outing_guests {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outing_id  String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  outings    outings  @relation(fields: [outing_id], references: [id], onDelete: Cascade)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([outing_id, user_id], map: "uq_outing_guests_outing_user")
  @@index([user_id], map: "idx_outing_guests_user_id")
}

model outing_vote_options {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outing_id          String               @db.Uuid
  place_id           String?              @db.Uuid
  name               String               @db.VarChar(200)
  area               String               @default("") @db.VarChar(200)
  latitude           Float?
  longitude          Float?
  image_url          String               @default("")
  vibe               outing_vibe          @default(FOOD)
  sort_order         Int                  @default(0)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  outing_place_votes outing_place_votes[]
  outings            outings              @relation(fields: [outing_id], references: [id], onDelete: Cascade)
  places             places?              @relation(fields: [place_id], references: [id])

  @@unique([outing_id, sort_order], map: "uq_outing_vote_options_order")
  @@index([outing_id], map: "idx_outing_vote_options_outing_id")
}

model outings {
  id                                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id                           String?                @db.Uuid
  created_by_id                      String                 @db.Uuid
  title                              String                 @db.VarChar(200)
  image_url                          String                 @default("")
  status                             outing_status          @default(UPCOMING)
  occasion                           outing_occasion        @default(NONE)
  vibe                               outing_vibe?
  scheduled_at                       DateTime?              @db.Timestamptz(6)
  vote_deadline_hours                Int?
  vote_ends_at                       DateTime?              @db.Timestamptz(6)
  location_name                      String?                @db.VarChar(200)
  location_area                      String?                @db.VarChar(200)
  location_lat                       Float?
  location_lng                       Float?
  location_place_id                  String?                @db.Uuid
  suggested_by_name                  String?                @db.VarChar(80)
  created_at                         DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                         DateTime               @default(now()) @db.Timestamptz(6)
  notifications                      notifications[]
  outing_attendance                  outing_attendance[]
  outing_chat_messages               outing_chat_messages[]
  outing_chat_reads                  outing_chat_reads[]
  outing_guests                      outing_guests[]
  outing_place_votes                 outing_place_votes[]
  outing_reads                       outing_reads[]
  outing_vote_options                outing_vote_options[]
  users_outings_created_by_idTousers users                  @relation("outings_created_by_idTousers", fields: [created_by_id], references: [id])
  groups                             groups?                @relation(fields: [group_id], references: [id], onDelete: Cascade)
  places                             places?                @relation(fields: [location_place_id], references: [id])
  saved_outings                      saved_outings[]

  @@index([created_by_id], map: "idx_outings_created_by_id")
  @@index([group_id], map: "idx_outings_group_id")
  @@index([group_id, status], map: "idx_outings_group_status")
  @@index([scheduled_at], map: "idx_outings_scheduled_at")
  @@index([status], map: "idx_outings_status")
}

model place_images {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  place_id   String   @db.Uuid
  image_url  String
  caption    String?
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  places     places   @relation(fields: [place_id], references: [id], onDelete: Cascade)

  @@unique([place_id, sort_order], map: "uq_place_images_order")
  @@index([place_id], map: "idx_place_images_place_id")
}

model place_prices {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  place_id   String  @db.Uuid
  label_key  String  @db.VarChar(64)
  amount     Decimal @db.Decimal(12, 2)
  currency   String  @default("EGP") @db.Char(3)
  sort_order Int     @default(0)
  places     places  @relation(fields: [place_id], references: [id], onDelete: Cascade)

  @@index([place_id], map: "idx_place_prices_place_id")
}

model places {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                    @db.VarChar(200)
  area                String                    @db.VarChar(200)
  description         String                    @default("")
  vibe                outing_vibe
  cover_image_url     String
  price_level         price_level               @default(MODERATE)
  price_min           Decimal?                  @db.Decimal(12, 2)
  price_max           Decimal?                  @db.Decimal(12, 2)
  currency            String                    @default("EGP") @db.Char(3)
  latitude            Float
  longitude           Float
  location            Unsupported("geography")?
  featured            Boolean                   @default(false)
  created_at          DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime                  @default(now()) @db.Timestamptz(6)
  outing_vote_options outing_vote_options[]
  outings             outings[]
  place_images        place_images[]
  place_opening_hours place_opening_hours[]
  place_prices        place_prices[]

  @@index([featured], map: "idx_places_featured")
  @@index([latitude, longitude], map: "idx_places_lat_lng")
  @@index([location], map: "idx_places_location_gist", type: Gist)
  @@index([vibe], map: "idx_places_vibe")
}

model saved_outings {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  outing_id  String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  outings    outings  @relation(fields: [outing_id], references: [id], onDelete: Cascade)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, outing_id], map: "uq_saved_outings_user_outing")
  @@index([user_id], map: "idx_saved_outings_user_id")
}

model users {
  id                                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firebase_uid                         String                 @unique(map: "uq_users_firebase_uid") @db.VarChar(128)
  name                                 String                 @db.VarChar(80)
  email                                String?                @unique(map: "uq_users_email") @db.VarChar(255)
  phone                                String?                @unique(map: "uq_users_phone") @db.VarChar(32)
  image_url                            String?
  created_at                           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                           DateTime               @default(now()) @db.Timestamptz(6)
  group_members                        group_members[]
  groups                               groups[]
  notifications                        notifications[]
  outing_attendance                    outing_attendance[]
  outing_chat_messages                 outing_chat_messages[]
  outing_chat_reads                    outing_chat_reads[]
  outing_guests                        outing_guests[]
  outing_place_votes                   outing_place_votes[]
  outing_reads                         outing_reads[]
  outings_outings_created_by_idTousers outings[]              @relation("outings_created_by_idTousers")
  saved_outings                        saved_outings[]
  user_fcm_tokens                      user_fcm_tokens[]

  @@index([firebase_uid], map: "idx_users_firebase_uid")
  @@index([phone], map: "idx_users_phone")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model outing_chat_messages {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outing_id  String   @db.Uuid
  sender_id  String   @db.Uuid
  text       String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  outings    outings  @relation(fields: [outing_id], references: [id], onDelete: Cascade)
  users      users    @relation(fields: [sender_id], references: [id])

  @@index([outing_id, created_at], map: "idx_outing_chat_messages_outing_created")
}

model outing_chat_reads {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outing_id    String   @db.Uuid
  user_id      String   @db.Uuid
  last_read_at DateTime @default(now()) @db.Timestamptz(6)
  outings      outings  @relation(fields: [outing_id], references: [id], onDelete: Cascade)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([outing_id, user_id], map: "uq_outing_chat_reads_outing_user")
  @@index([user_id], map: "idx_outing_chat_reads_user_id")
}

model outing_place_votes {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outing_id           String              @db.Uuid
  user_id             String              @db.Uuid
  vote_option_id      String              @db.Uuid
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime            @default(now()) @db.Timestamptz(6)
  outings             outings             @relation(fields: [outing_id], references: [id], onDelete: Cascade)
  users               users               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  outing_vote_options outing_vote_options @relation(fields: [vote_option_id], references: [id], onDelete: Cascade)

  @@unique([outing_id, user_id], map: "uq_outing_place_votes_outing_user")
  @@index([vote_option_id], map: "idx_outing_place_votes_option_id")
  @@index([outing_id], map: "idx_outing_place_votes_outing_id")
}

model outing_reads {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outing_id String   @db.Uuid
  user_id   String   @db.Uuid
  seen_at   DateTime @default(now()) @db.Timestamptz(6)
  outings   outings  @relation(fields: [outing_id], references: [id], onDelete: Cascade)
  users     users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([outing_id, user_id], map: "uq_outing_reads_outing_user")
  @@index([user_id], map: "idx_outing_reads_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model place_opening_hours {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  place_id       String    @db.Uuid
  day            weekday
  is_closed      Boolean   @default(false)
  opens_at       DateTime? @db.Time(6)
  closes_at      DateTime? @db.Time(6)
  interval_index Int       @default(0)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  places         places    @relation(fields: [place_id], references: [id], onDelete: Cascade)

  @@unique([place_id, day, interval_index], map: "uq_place_hours_day_interval")
  @@index([place_id], map: "idx_place_opening_hours_place_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model user_fcm_tokens {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  token      String   @unique(map: "uq_user_fcm_tokens_token")
  platform   String?  @db.VarChar(32)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_user_fcm_tokens_user_id")
}

enum attendance_status {
  GOING
  NOT_GOING
}

enum group_role {
  OWNER
  MEMBER
}

enum notification_type {
  OUTING
  GROUP
  CHAT
  VOTE
  INVITATION
  SYSTEM
}

enum outing_occasion {
  NONE
  BIRTHDAY
  WEDDING
}

enum outing_status {
  UPCOMING
  VOTING
  PAST
}

enum outing_vibe {
  FOOD
  ACTIVITY
  OUTDOOR
  MOVIE
}

enum price_level {
  FREE
  BUDGET
  MODERATE
  EXPENSIVE
  LUXURY
}

enum weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
