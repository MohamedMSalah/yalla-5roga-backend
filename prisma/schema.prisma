generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model chat_messages {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outing_id       String                  @db.Uuid
  sender_id       String
  text            String
  delivery_status message_delivery_status @default(sent)
  sent_at         DateTime                @default(now()) @db.Timestamptz(6)
  outings         outings                 @relation(fields: [outing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users                   @relation(fields: [sender_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([outing_id, sent_at], map: "chat_messages_outing_sent_idx")
}

model chat_read_cursors {
  outing_id    String   @db.Uuid
  user_id      String
  last_read_at DateTime @default(now()) @db.Timestamptz(6)
  outings      outings  @relation(fields: [outing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([outing_id, user_id])
}

model fcm_tokens {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String
  token      String   @unique
  platform   String?
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model group_invites {
  id                                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id                                   String   @db.Uuid
  invited_by_id                              String
  phone                                      String?
  invited_user_id                            String?
  status                                     String   @default("pending")
  created_at                                 DateTime @default(now()) @db.Timestamptz(6)
  groups                                     groups   @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_group_invites_invited_by_idTousers   users    @relation("group_invites_invited_by_idTousers", fields: [invited_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_group_invites_invited_user_idTousers users?   @relation("group_invites_invited_user_idTousers", fields: [invited_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model group_members {
  group_id  String     @db.Uuid
  user_id   String
  role      group_role @default(member)
  joined_at DateTime   @default(now()) @db.Timestamptz(6)
  groups    groups     @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([group_id, user_id])
}

model group_read_cursors {
  group_id     String   @db.Uuid
  user_id      String
  last_read_at DateTime @default(now()) @db.Timestamptz(6)
  groups       groups   @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([group_id, user_id])
}

model groups {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  image_url          String               @default("")
  featured           Boolean              @default(false)
  decision           String?
  created_by_id      String?
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  group_invites      group_invites[]
  group_members      group_members[]
  group_read_cursors group_read_cursors[]
  users              users?               @relation(fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notifications      notifications[]
  outing_drafts      outing_drafts[]
  outings            outings[]
}

model notifications {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String
  body       String
  type       notification_type @default(system)
  image_url  String?
  outing_id  String?           @db.Uuid
  group_id   String?           @db.Uuid
  action     Boolean           @default(false)
  unread     Boolean           @default(true)
  created_at DateTime          @default(now()) @db.Timestamptz(6)
  groups     groups?           @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  outings    outings?          @relation(fields: [outing_id], references: [id], onUpdate: NoAction)
  users      users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "notifications_user_created_idx")
}

model outing_attendance {
  outing_id  String            @db.Uuid
  user_id    String
  status     attendance_status @default(not_voted)
  updated_at DateTime          @default(now()) @db.Timestamptz(6)
  outings    outings           @relation(fields: [outing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([outing_id, user_id])
}

model outing_drafts {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String
  title               String          @default("")
  image_url           String          @default("")
  location_name       String          @default("")
  location_area       String          @default("")
  location_lat        Float?
  location_lng        Float?
  date                DateTime?       @db.Date
  hour                Int             @default(11)
  minute              Int             @default(30)
  vibe                outing_vibe     @default(food)
  group_id            String?         @db.Uuid
  occasion            outing_occasion @default(none)
  special_event       Boolean         @default(false)
  let_vote            Boolean         @default(false)
  vote_deadline_hours Int?
  guest_ids           String[]        @default([])
  selected_places     Json            @default("[]")
  updated_at          DateTime        @default(now()) @db.Timestamptz(6)
  groups              groups?         @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  users               users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model outing_guests {
  outing_id String  @db.Uuid
  user_id   String
  outings   outings @relation(fields: [outing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([outing_id, user_id])
}

model outing_vote_options {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outing_id    String         @db.Uuid
  place_id     String         @db.Uuid
  label        String
  sort_order   Int            @default(0)
  outings      outings        @relation(fields: [outing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  places       places         @relation(fields: [place_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  outing_votes outing_votes[]

  @@unique([outing_id, place_id])
}

model outing_votes {
  outing_id           String              @db.Uuid
  user_id             String
  option_id           String              @db.Uuid
  voted_at            DateTime            @default(now()) @db.Timestamptz(6)
  outing_vote_options outing_vote_options @relation(fields: [option_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  outings             outings             @relation(fields: [outing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users               users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([outing_id, user_id])
}

model outings {
  id                                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                                String
  image_url                            String                @default("")
  group_id                             String?               @db.Uuid
  created_by_id                        String?
  status                               outing_status         @default(upcoming)
  occasion                             outing_occasion       @default(none)
  scheduled_at                         DateTime?             @db.Timestamptz(6)
  location_name                        String?
  location_area                        String?
  location_lat                         Float?
  location_lng                         Float?
  location_place_id                    String?               @db.Uuid
  vote_deadline_hours                  Int?
  vote_ends_at                         DateTime?             @db.Timestamptz(6)
  suggested_by_id                      String?
  created_at                           DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                           DateTime              @default(now()) @db.Timestamptz(6)
  chat_messages                        chat_messages[]
  chat_read_cursors                    chat_read_cursors[]
  notifications                        notifications[]
  outing_attendance                    outing_attendance[]
  outing_guests                        outing_guests[]
  outing_vote_options                  outing_vote_options[]
  outing_votes                         outing_votes[]
  users_outings_created_by_idTousers   users?                @relation("outings_created_by_idTousers", fields: [created_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groups                               groups?               @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  places                               places?               @relation(fields: [location_place_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_outings_suggested_by_idTousers users?                @relation("outings_suggested_by_idTousers", fields: [suggested_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  saved_outings                        saved_outings[]
}

model place_hours {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  place_id  String    @db.Uuid
  day       weekday
  opens_at  DateTime? @db.Time(6)
  closes_at DateTime? @db.Time(6)
  is_closed Boolean   @default(false)
  places    places    @relation(fields: [place_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([place_id, day])
}

model place_images {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  place_id   String  @db.Uuid
  image_url  String
  caption    String?
  sort_order Int     @default(0)
  places     places  @relation(fields: [place_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model place_prices {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  place_id  String  @db.Uuid
  label_key String
  amount    Decimal @db.Decimal(12, 2)
  currency  String  @default("EGP")
  places    places  @relation(fields: [place_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model places {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  area                String                @default("")
  vibe                outing_vibe           @default(food)
  cover_image_url     String                @default("")
  description         String                @default("")
  price_level         price_level           @default(moderate)
  price_min           Decimal?              @db.Decimal(12, 2)
  price_max           Decimal?              @db.Decimal(12, 2)
  currency            String                @default("EGP")
  latitude            Float?
  longitude           Float?
  featured            Boolean               @default(false)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  outing_vote_options outing_vote_options[]
  outings             outings[]
  place_hours         place_hours[]
  place_images        place_images[]
  place_prices        place_prices[]
}

model saved_outings {
  user_id   String
  outing_id String   @db.Uuid
  saved_at  DateTime @default(now()) @db.Timestamptz(6)
  outings   outings  @relation(fields: [outing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, outing_id])
}

model users {
  id                                                 String               @id
  name                                               String
  phone                                              String               @unique
  email                                              String?              @unique
  image_url                                          String?
  created_at                                         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                                         DateTime             @default(now()) @db.Timestamptz(6)
  password_hash                                      String?
  chat_messages                                      chat_messages[]
  chat_read_cursors                                  chat_read_cursors[]
  fcm_tokens                                         fcm_tokens[]
  group_invites_group_invites_invited_by_idTousers   group_invites[]      @relation("group_invites_invited_by_idTousers")
  group_invites_group_invites_invited_user_idTousers group_invites[]      @relation("group_invites_invited_user_idTousers")
  group_members                                      group_members[]
  group_read_cursors                                 group_read_cursors[]
  groups                                             groups[]
  notifications                                      notifications[]
  outing_attendance                                  outing_attendance[]
  outing_drafts                                      outing_drafts[]
  outing_guests                                      outing_guests[]
  outing_votes                                       outing_votes[]
  outings_outings_created_by_idTousers               outings[]            @relation("outings_created_by_idTousers")
  outings_outings_suggested_by_idTousers             outings[]            @relation("outings_suggested_by_idTousers")
  saved_outings                                      saved_outings[]
}

enum attendance_status {
  going
  not_going
  not_voted
}

enum group_role {
  owner
  admin
  member
}

enum message_delivery_status {
  sent
  delivered
  seen
}

enum notification_type {
  outing
  group
  chat
  vote
  invitation
  system
}

enum outing_occasion {
  none
  birthday
  wedding
}

enum outing_status {
  upcoming
  voting
  past
}

enum outing_vibe {
  food
  activity
  outdoor
  movie
}

enum price_level {
  free
  budget
  moderate
  expensive
  luxury
}

enum weekday {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}
