# Neon pooled URL for the API. Leave out channel_binding — Prisma closes
# the connection when that parameter is present.
# postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
PORT=3000
NODE_ENV=development

# Firebase Admin SDK (service account) — must match the Flutter Firebase project
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Flutter (yalla_5roga) points at this server with no /api prefix:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:3000   # Android emulator
#   flutter run --dart-define=API_BASE_URL=http://localhost:3000  # iOS simulator / desktop
#   flutter run --dart-define=API_BASE_URL=http://<LAN-IP>:3000   # physical device
# Ensure AppConfig.useMockData = false in the Flutter app.
